<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /pustaka/

    RewriteRule ^(application|system|storage|db_backup|Buku|docs|sql|scripts|deploy)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 /pustaka/index.php
</IfModule>
